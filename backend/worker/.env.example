REDIS_URL=redis://localhost:6379
SUPABASE_URL=
SUPABASE_KEY=

# Text generation (Groq via LiteLLM). LLM_MODEL overrides the primary model
# in the fallback chain (see ml/generation.py); leave unset to use the default.
LLM_MODEL=groq/openai/gpt-oss-120b
LLM_MAX_TOKENS=4096
GROQ_API_KEY=

# Embeddings + reranking. Optional — omit to fall back to a local
# sentence-transformers model (slower, no API cost).
VOYAGE_API_KEY=
VOYAGE_EMBEDDING_MODEL=voyage-3
VOYAGE_RERANK_MODEL=rerank-2

# Query-time vision (answering questions about a specific image). Optional —
# without it, image questions fall back to the OCR text captured at ingestion.
GEMINI_API_KEY=
